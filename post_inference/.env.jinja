# AWS Configuration (local development)
AWS_PROFILE_POST_REVIEWER={{ aws.profile_post_reviewer }}
AWS_REGION={{ aws.region }}

# S3 Configuration
TRANSCRIPTION_BUCKET={{ s3.transcription_bucket }}
OUTPUT_BUCKET={{ s3.output_bucket }}
AUDIO_BUCKET={{ s3.audio_bucket }}

# SQS Configuration
SQS_QUEUE_URL={{ sqs.fix_transcribes_queue_url }}

# Gemini webhook (uncomment when using GeminiPostProcessing)
GOOGLE_WEBHOOK_AUDIENCE={{ gemini.webhook_audience }}
GOOGLE_JWKS_URL=https://generativelanguage.googleapis.com/.well-known/jwks.json
GEMINI_WEBHOOK_SIGN_SECRET={{ gemini.webhook_sign_secret }}
BATCH_JOBS_TABLE={{ dynamodb.batch_jobs_table }}
REVIEWER_FUNCTION_NAME={{ aws.reviewer_function_name }}
