# AWS Configuration (local development)
AWS_PROFILE_REVIEWER={{ aws.profile_reviewer }}
AWS_REGION={{ aws.region }}

# S3 Configuration
TRANSCRIPTION_BUCKET={{ s3.transcription_bucket }}

# DynamoDB Configuration
MEDIA_TABLE={{ dynamodb.table_name }}
BATCH_JOBS_TABLE={{ dynamodb.batch_jobs_table }}

# Bedrock Configuration
BEDROCK_MODEL_ID={{ bedrock.model_id }}
BATCH_MODEL_ID={{ bedrock.batch_model_id }}
BATCH_ROLE_ARN={{ bedrock.batch_role_arn }}

# Batch Processing Configuration
MIN_ENTRIES={{ batch.min_entries }}
MAX_TOKENS={{ batch.max_tokens }}
TEMPERATURE={{ batch.temperature }}

# LLM Backend Selection (AWS_OPUS4.5 | GEMINI2.5 | GEMINI_BATCH)
LLM_BACKEND={{ llm_backend }}

# Google Gemini Configuration (only needed if LLM_BACKEND=GEMINI2.5)
GOOGLE_API_KEY={{ google_api_key }}
GEMINI_MODEL={{ gemini_model }}

# SQS Configuration
SQS_QUEUE_URL={{ sqs.fix_transcribes_queue_url }}

# Gemini Splitting Configuration
SPLIT_BY_WORDS={{ gemini.split_by_words }}
SPLIT_BY_WORDS_MAX={{ gemini.split_by_words_max }}
MAX_WORD_DIFF={{ gemini.max_word_diff }}
THINKING_BUDGET={{ gemini.thinking_budget }}

# Gemini Caching Configuration
GEMINI_CACHE_ENABLED={{ gemini.cache_enabled }}
GEMINI_CACHE_TTL_SECONDS={{ gemini.cache_ttl_seconds }}
GEMINI_CACHE_GUARD_SECONDS={{ gemini.cache_guard_seconds }}

# Gemini Batch Webhook
GEMINI_BATCH_WEBHOOK_URL={{ gemini.batch_webhook_url }}

# Processing Configuration
MAX_SEGMENT_DURATION_SECONDS={{ statistics.max_segment_duration_seconds }}
TIMEOUT_THRESHOLD_MS={{ lambda.timeout_threshold_ms }}

# Fix Tracker Configuration
FIX_TRACKER_TABLE={{ fix_tracker.table }}
TEMPORARY_FIX_BUCKET={{ fix_tracker.temporary_fix_bucket }}
DEAD_LETTER_BUCKET={{ fix_tracker.dead_letter_bucket }}
MAX_LAMBDA_AGE_SECONDS={{ fix_tracker.max_lambda_age_seconds }}
SLOW_LLM_THRESHOLD_MS={{ fix_tracker.slow_llm_threshold_ms }}
MAX_RETRIES={{ fix_tracker.max_retries }}
